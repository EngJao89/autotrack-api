// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  firebaseUid  String?   @unique
  email        String    @unique
  name         String?
  cnh          String?   @unique
  document     String?   @unique
  documentType String?
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  vehicles     Vehicle[]
}

model Vehicle {
  id           String          @id @default(cuid())
  userId       String
  brand        String
  model        String
  version      String?
  year         Int
  licensePlate String?
  color        String?
  fuelType     String?
  odometerKm   Int?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  maintenances Maintenance[]
  estimates    RepairEstimate[]

  @@index([userId])
}

enum MaintenanceStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Maintenance {
  id           String            @id @default(cuid())
  vehicleId    String
  type         String
  status       MaintenanceStatus @default(TODO)
  description  String?
  serviceDate  DateTime
  odometerKm   Int?
  costCents    Int?
  workshopName String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  vehicle      Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([status])
}

enum RepairEstimateStatus {
  DRAFT
  FINALIZED
  ARCHIVED
}

enum RepairEstimateItemCategory {
  PART
  LABOR
}

/// Repair cost estimate (ATP-38). Separate from Maintenance (executed service).
model RepairEstimate {
  id          String               @id @default(cuid())
  vehicleId   String
  title       String
  description String?
  currency    String               @default("BRL")
  status      RepairEstimateStatus @default(DRAFT)
  totalCents  Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  vehicle     Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items       RepairEstimateItem[]

  @@index([vehicleId])
  @@index([status])
}

model RepairEstimateItem {
  id             String                      @id @default(cuid())
  estimateId     String
  description    String
  category       RepairEstimateItemCategory
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int
  sortOrder      Int                         @default(0)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  estimate       RepairEstimate              @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}
