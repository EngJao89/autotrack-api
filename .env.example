# Environment variables for local development.
# Copy this file to `.env` and adjust values as needed.
# Do not commit real secrets.

# App
PORT=3333
# Host port published by Docker Compose (avoids shell PORT overrides)
API_PORT=3333
NODE_ENV=development

# Swagger/OpenAPI UI at /api/docs (enabled when not production, unless overridden)
SWAGGER_ENABLED=true

# PostgreSQL (Docker Compose)
POSTGRES_USER=autotrack
POSTGRES_PASSWORD=autotrack
POSTGRES_DB=autotrack
POSTGRES_HOST=localhost
# Host port mapped to container 5432. Use 5433 if local 5432 is already taken.
POSTGRES_PORT=5433

# Prisma / PostgreSQL
# From host machine (API outside Docker):
DATABASE_URL="postgresql://autotrack:autotrack@localhost:5433/autotrack?schema=public"
# From API container, Compose overrides to:
# DATABASE_URL="postgresql://autotrack:autotrack@postgres:5432/autotrack?schema=public"
#
# On Render/demo, set DATABASE_URL only in the dashboard (never commit secrets).
# Managed Postgres usually needs SSL, e.g.:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# PGSSL=true

# Firebase Authentication (Admin SDK — service account)
# Required only for protected routes (e.g. GET /v1/auth/me).
# Never commit real values. If the private key has newlines, keep them escaped as \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local development adapter for Vehicles ownership (X-User-Id header).
# Enabled by default when NODE_ENV !== production. Always disabled in production.
# LOCAL_USER_ID_HEADER_ENABLED=true

